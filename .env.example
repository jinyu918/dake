# 官方取数接口。当前在七牛内网可直接访问，请求里暂无鉴权头。
CHAT_RECORDS_URL=https://ts.qiniu.io/api/mars_alert/qq/chatRecords

# 默认仅本机；局域网展示时追加本机局域网 IP，前端用 npm run dev:lan 启动。
API_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# 本项目独立 MySQL；仅监听本机，数据保存在 data/mysql/。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=dake_aftersales
MYSQL_USER=dake
# 复制到 .env 后设置两个不同的随机密码，勿提交 .env。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 本项目独立 MongoDB（用于可配置产品属性 Schema 与事件聚合分析）；仅监听本机，数据保存在 data/mongo/。
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_PORT=27017
MONGO_DATABASE=dake_aftersales

# 默认处理范围；CLI 日期 end 包含当天，内部时间窗口为 [start, end)。
# 业务时间统一为 Asia/Shanghai。
PROCESS_UID=1383603926
PROCESS_START=2026-11-08
PROCESS_END=2026-11-12
# 默认周期及独立窗口；均为开发缺省，不是官方评分规则。
PROCESS_INTERVAL=15m
CONTEXT_LOOKBACK=3d
MATCH_WINDOW=7d
CLOSED_GRACE=7d
INGEST_LOOKBACK=2d

# 状态与等级的官方枚举待确认；不得用开发缺省冒充官方标准。
DEFAULT_STATUS=未知
DEFAULT_SEVERITY=未知
# 官方关闭状态待确认；确认后用逗号分隔填写，当前留空。
CLOSED_STATUSES=

# 缺省仍只验证链路；获授权后显式设为 xhub，才会向指定网关发送客户聊天。
LLM_PROVIDER=stub
XHub_BASE_URL=https://llmapi.qiniu.io
XHub_API_KEY=
XHub_MODEL=gpt-6.1-sol
XHub_MAX_TOKENS=8192
# 按日回放的历史消息较多时，可把单次等待时间调至 300 秒。
XHub_TIMEOUT_SECONDS=120
# 后台任务并发分析槽位、实时预留名额与超前取数窗口数。
ANALYSIS_SLOTS=6
LIVE_RESERVED=1
FETCH_AHEAD=6
DATA_DIR=data
