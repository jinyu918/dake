{
  "name": "dake-aftersales-web",
  "version": "0.1.0",
  "private": true,
  "description": "大客售后事件工作台",
  "scripts": {
    "predev": "node scripts/patch-umi-host.mjs",
    "dev": "cross-env HOST=127.0.0.1 PORT=8000 umi dev",
    "predev:lan": "node scripts/patch-umi-host.mjs",
    "dev:lan": "cross-env HOST=0.0.0.0 PORT=8000 umi dev",
    "start": "npm run dev",
    "build": "umi build",
    "prepare": "node scripts/patch-umi-host.mjs && umi setup",
    "openapi": "node openapi.mts",
    "lint": "biome check && tsc --noEmit",
    "format": "biome check --write",
    "test": "playwright test"
  },
  "dependencies": {
    "@daypicker/react": "^10.0.2",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/webpack": "^4.3.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/openapi": "1.14.1",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "umi": "4.7.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
